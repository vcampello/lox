// basic
print "hello";
print "";
print "a b c";

// multi-line
print "line1
line2
line3";

// concatenation
print "hello" + " " + "world";
print "a" + "b" + "c";

// truthiness (strings are truthy unless nil)
print "ok" or "fallback";
print "" or "empty is still truthy";

// comparisons
print "abc" == "abc";
print "abc" != "def";

// escape sequences
print "tab:\there";
print "quote:\"inside\"";
print "newline:\nseparated";
print "backslash:\\";
